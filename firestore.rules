rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A estante é pública para leitura; apenas o admin grava.
    match /books/{bookId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'willy.cornelissen@gmail.com';
    }
  }
}
